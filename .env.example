# ---- Required ----
BOT_TOKEN=123456:ABC-your-bot-token
OWNER_ID=123456789                     # backward-compatible primary owner
OWNER_IDS=123456789,987654321           # multiple owners; OWNER_ID is included automatically
LOG_CHANNEL=-1001234567890        # naye users + payment logs yaha aayenge
# Source chat IDs are now configured by the owner in Movie Channel Set; MAIN_DATA is the user catalog.
MAIN_DATA=-1003463663979             # canonical catalog/storage channel (bot admin ho)
SCAN_START_ID=200000                 # recovery upper ceiling; increase if MAIN_DATA IDs are higher
RECOVERY_WINDOW=5000                 # restart par newest-side scan window
AUTO_SCAN_INTERVAL_SECONDS=300       # recurring auto-index interval (seconds, min 60)

# ---- Optional ----
FORCE_CHANNELS=@channel1,@channel2   # must-join channels (owner panel se bhi set ho sakte hain)
DB_PATH=bot.db                         # optional local cache; Mongo stores non-movie state
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=tv_show_bot                    # users/settings/history/payments + movie catalog backup
TG_API_ID=                              # numeric API ID from my.telegram.org
TG_API_HASH=                            # Telegram API hash
TG_SESSION=                             # optional: Owner Panel → Login Account se bhi set hota hai
ONLINE_PLAYER_BOT=@YourOnlinePlayerBot       # group VC player bot shown to users
OPENAI_API_KEY=                      # voice search (whisper transcription)
OPENAI_BASE_URL=https://api.openai.com/v1
START_PIC_URL=                       # GitHub raw link of start image
QR_URL=                              # GitHub raw link of payment QR
UPI_ID=
CAPTION_JOIN=https://t.me/YourJoinChannel       # optional default for 📢 Join
CAPTION_VISIT=https://t.me/YourBotUsername       # optional default for 🌐 Visit
BUTTON_STYLE=1                         # enable Telegram style fields when supported
DEFAULT_BUTTON_STYLE=primary            # primary, success, or danger
BUTTON_ICON_CUSTOM_EMOJI_ID=5443038326535759644

# ============ MULTI-BOT TRANSFER SYSTEM ============
# Helper bot tokens (comma-separated) for parallel file transfers
# Main bot NEVER transfers - these bots do all the work
HELPER_BOT_TOKENS=

# Concurrent transfers (5-20 recommended)
TRANSFER_CONCURRENCY=10

# Transfer mode: auto (forward->copy), forward, copy
TRANSFER_MODE=auto
# ===================================================

# Extra "joiner" Telegram accounts (string sessions, comma separated). They only need to
# JOIN the source channels; whichever account sees a new upload first mirrors it.
# Easier: Owner Panel → 🔐 Login Account → ➕ Add Joiner Account.
EXTRA_TG_SESSIONS=
